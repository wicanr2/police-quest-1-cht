FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates build-essential cmake git python3 python3-pil fonts-arphic-uming unzip zip \
    xvfb xdotool imagemagick ffmpeg fonts-noto-cjk \
    libsdl2-dev libsdl2-net-2.0-0 libjpeg62-turbo-dev libpng-dev libmpeg2-4-dev \
    libtheora-dev libvorbis-dev libmad0-dev && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
