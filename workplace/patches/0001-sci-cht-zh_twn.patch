+void SciEngine::showChtHelp() {
+	// Guard against re-entry (F1 pressed again while the box is up).
+	if (_inChtHelp || !_gfxPaint16 || !_gfxText16 || !_gfxPorts || !_gfxScreen)
+		return;
+	const char *help = getChtTranslation("PQ1_CHT_HELP");
+	if (!help)
+		return;
+	_inChtHelp = true;
+
+	// Draw in the full-screen menu port so coords are screen-absolute (320x200 script
+	// space; GfxScreen handles the 640x400 ZH_TWN upscale). Drawing at top >= 8 keeps
+	// GfxFontChinese on the sharp hi-res path (the status/menu low-res path is top < 8).
+	Port *oldPort = _gfxPorts->setPort(_gfxPorts->_menuPort);
+
+	// Split into lines on '\n' so the box hugs the content and we can use a tight
+	// line pitch (denser than GfxText16::Box, which advances by the full font height).
+	Common::Array<Common::String> lines;
+	Common::String cur;
+	for (const char *p = help; *p; ++p) {
+		if (*p == '\n') { lines.push_back(cur); cur.clear(); }
+		else cur += *p;
+	}
+	lines.push_back(cur);
+
+	const int16 pitch = 13;                 // tight line spacing (hi-res glyphs ~12px tall)
+	const int16 padX = 8, padY = 6;
+	int16 maxW = 0;
+	for (uint i = 0; i < lines.size(); ++i) {
+		if (lines[i].empty())
+			continue;
+		int16 w = 0, h = 0;
+		_gfxText16->StringWidth(lines[i], 0, w, h);
+		maxW = MAX<int16>(maxW, w);
+	}
+	int16 boxW = MIN<int16>(304, maxW + 2 * padX);
+	int16 boxH = (int16)lines.size() * pitch + 2 * padY;
+	int16 boxL = (320 - boxW) / 2;
+	int16 boxT = 20 + (200 - 20 - boxH) / 2; // centered below the status bar
+	if (boxT < 20)
+		boxT = 20;
+	Common::Rect box(boxL, boxT, boxL + boxW, boxT + boxH);
+
+	reg_t saved = _gfxPaint16->bitsSave(box, GFX_SCREEN_MASK_VISUAL);
+	_gfxPaint16->fillRect(box, GFX_SCREEN_MASK_VISUAL, _gfxScreen->getColorWhite());
+	_gfxPaint16->frameRect(box);
+	int16 oldColor = _gfxPorts->getPort()->penClr;
+	_gfxPorts->penColor(0); // black text on the white box
+	for (uint i = 0; i < lines.size(); ++i) {
+		if (lines[i].empty())
+			continue;
+		_gfxPorts->moveTo(boxL + padX, boxT + padY + (int16)i * pitch);
+		_gfxText16->Draw(lines[i].c_str(), 0, (int16)lines[i].size(), 0, 0);
+	}
+	_gfxPorts->penColor(oldColor);
+	_gfxPaint16->bitsShow(box);
+
+	// Modal wait: any key / mouse click / quit dismisses the box.
+	while (!shouldQuit()) {
+		SciEvent e = _eventMan->getSciEvent(kSciEventKeyDown | kSciEventMousePress | kSciEventQuit);
+		if (e.type != kSciEventNone)
+			break;
+		g_system->delayMillis(10);
+		g_system->updateScreen();
+	}
+
+	_gfxPaint16->bitsRestore(saved);
+	_gfxPaint16->bitsShow(box);
+	_gfxPorts->setPort(oldPort);
+	_inChtHelp = false;
+}
