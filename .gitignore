# Original game data is supplied by the player and must never enter patch-only Git.
workplace/original/
workplace/game/
workplace/extract/
workplace/out/
workplace/build/
workplace/build-scummvm-agi
workplace/scummvm-src/
workplace/dist-all/
workplace/.build-sci-src/
workplace/.build-agi-src/
workplace/.build-win/
workplace/.build-macos/
workplace/.build-linux/
workplace/.upstream-src/
/dist-all/
*.ROM
*.core
__pycache__/
*.pyc
.DS_Store

# Source archives of the original game. Players supply their own copy.
*.zip

# Headless debugging logs. Only the two loader records referenced by the README
# are kept; the rest are one-off traces from individual debugging runs.
workplace/*.log
!workplace/latest-agi-run.log
!workplace/latest-sci-run.log

# Intermediate translation artifacts. translation/batch/ is the versioned source
# of truth; these are regenerated by tools/prep_pending_batches.py and by the
# translator workflow.
workplace/translation/pending/
workplace/translation/staging/

# Screenshots are build products. Only the ones the README cites as acceptance
# evidence are versioned.
workplace/captures/*
!workplace/captures/pq1-agi-cht-start.png
!workplace/captures/pq1-agi-fontfix-01-after-enter1.png
